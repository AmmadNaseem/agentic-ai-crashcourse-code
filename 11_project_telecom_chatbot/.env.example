# Copy this file to .env and fill in your key
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
HF_TOKEN=your_huggingface_token_here

TELECOM_MODEL=qwen/qwen3.8-27b
TELECOM_MAX_TOKENS=512
TELECOM_OUTPUT_TOKEN_LIMIT=1000
TELECOM_TIMEOUT=60
TELECOM_MAX_RETRIES=2
TELECOM_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
